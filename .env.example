# Get your connection string from Supabase/Neon dashboard
# For Supabase: Use "Transaction" pooler connection string
# For Neon: Use the pooled connection string

DATABASE_URL="postgresql://user:password@host:5432/ovenisto?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:8080

# Safepay (website online payment). All four set = the "Pay online" option can be switched on.
# Keys come from the Safepay merchant dashboard (sandbox keys from the sandbox dashboard).
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_V1_SECRET=
SAFEPAY_WEBHOOK_SECRET=
# Register https://<api host>/api/payments/safepay/webhook as the webhook URL in the Safepay dashboard.
