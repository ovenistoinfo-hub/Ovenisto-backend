// Prisma schema for Ovenisto POS System
// Generated from BACKEND_DEVELOPMENT_GUIDE.md
// Covers all 10 implementation phases

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// PHASE 1: Auth & Users
// =============================================

model Outlet {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  address   String?
  city      String?  @db.VarChar(50)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relations
  users            User[]
  settings         Settings[]
  loyaltySettings  LoyaltySettings[]
  transfersFrom    Transfer[]        @relation("TransferFrom")
  transfersTo      Transfer[]        @relation("TransferTo")
  warehouses       Warehouse[]
  orders           Order[]           @relation("OrderOutlet")
  stockAdjustments StockAdjustment[]
  stockTakes       StockTake[]
  productions      Production[]
  wasteRecords     WasteRecord[]
  shifts           Shift[]
  restaurantTables RestaurantTable[]
  expenses         Expense[]
  purchases        Purchase[]
  reservations      Reservation[]
  customers         Customer[]
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  staffSchedules    StaffSchedule[]
  employees         Employee[]
  warehouseSettlements WarehouseSettlement[]
  suppliers        Supplier[]
  ingredients      Ingredient[]
  outletIngredientSuppliers OutletIngredientSupplier[]
  cashSettlements  CashSettlement[]

  dueToMain Decimal @default(0) @db.Decimal(10, 2)

  @@map("outlets")
}

enum UserRole {
  SUPER_ADMIN      @map("Super Admin")
  ADMIN            @map("Admin")
  MANAGER          @map("Manager")
  CASHIER          @map("Cashier")
  WAITER           @map("Waiter")
  KITCHEN          @map("Kitchen Staff")
  KITCHEN_MANAGER  @map("Kitchen Manager")
  FLOOR_MANAGER    @map("Floor Manager")
  DELIVERY_MANAGER @map("Delivery Manager")
  STORE_MANAGER    @map("Store Manager")
  ACCOUNTANT       @map("Accountant")
  RIDER            @map("Rider")
  CUSTOMER_SCREEN  @map("Customer Screen")
}

model User {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  role         UserRole
  branch       String?   @db.VarChar(100)
  outletId     String?
  avatar         String?
  status         String    @default("active") @db.VarChar(20)
  lastLogin      DateTime?
  createdAt      DateTime  @default(now())
  pinHash        String?   @db.VarChar(255) // bcrypt hash of a 4-digit PIN; Super Admin/Admin/Manager/Floor Manager only

  // Relations
  outlet                   Outlet?           @relation(fields: [outletId], references: [id])
  employee                 Employee?
  orders                   Order[]
  selfOrdersAccepted       Order[]           @relation("OrderAcceptedBy")
  stockAdjustments         StockAdjustment[]
  attendanceRecords        AttendanceRecord[]  @relation("UserAttendance")
  leaveRequests            LeaveRequest[]      @relation("UserLeaves")
  leaveReviews             LeaveRequest[]      @relation("LeaveReviewer")
  leaveBalance             LeaveBalance[]
  staffSchedules           StaffSchedule[]     @relation("UserSchedules")
  shifts                   Shift[]
  riderProfile             DeliveryRider?
  managedWarehouses        Warehouse[]       @relation("WarehouseManager")
  challansDispatched       StockChallan[]    @relation("ChallanDispatched")
  challansReceived         StockChallan[]    @relation("ChallanReceived")
  challansCreated          StockChallan[]    @relation("ChallanCreated")
  demandsRequested         StockDemand[]     @relation("DemandRequested")
  demandsApproved          StockDemand[]     @relation("DemandApproved")
  purchaseRequests         PurchaseRequest[] @relation("PurchaseRequestedBy")
  purchaseRequestApprovals PurchaseRequest[] @relation("PurchaseApprovedBy")
  purchasesCreated         Purchase[]        @relation("PurchaseCreatedBy")
  orderCancelAuthorizations OrderModificationLog[] @relation("OrderCancelAuthorizedBy")
  paymentLogsPaid          PaymentLog[]      @relation("PaymentLogPaidBy")
  warehouseSettlementsRecorded WarehouseSettlement[] @relation("SettlementRecordedBy")
  cancelRequestsMade        OrderCancellationRequest[] @relation("CancelReqRequestedBy")
  cancelRequestsToApprove   OrderCancellationRequest[] @relation("CancelReqApprover")
  cancelRequestsResponsible OrderCancellationRequest[] @relation("CancelReqResponsible")
  cancelRequestsReviewed    OrderCancellationRequest[] @relation("CancelReqReviewedBy")
  staffPenalties            StaffPenalty[]             @relation("StaffPenaltyUser")
  purchasePayments          PurchasePayment[]
  staffSettlements          CashSettlement[]           @relation("StaffSettlements")
  managerSettlements        CashSettlement[]           @relation("ManagerApprovedSettlements")

  @@map("users")
}

model Employee {
  id           String    @id @default(uuid())
  userId       String?   @unique
  outletId     String?
  supervisorId String?

  // Basic
  firstName String  @db.VarChar(100)
  lastName  String? @db.VarChar(100)
  email     String? @db.VarChar(100)
  phone     String  @db.VarChar(20)
  photoUrl  String?

  // Positional / Pay
  division     String?  @db.VarChar(100)
  designation  String   @db.VarChar(100)
  dutyType     String?  @db.VarChar(20) // Full Time | Part Time
  hireDate     DateTime
  rateType     String   @db.VarChar(20) // Hourly | Daily | Monthly | PerShift
  rate         Decimal  @db.Decimal(10, 2)
  payFrequency String?  @db.VarChar(20) // Weekly | BiWeekly | Monthly
  penaltyFee   Decimal? @db.Decimal(10, 2)
  defaultOffDay Int?    @default(1) // 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday
  commissionPerDelivery Decimal @default(0) @db.Decimal(10, 2)

  // Biographical
  dateOfBirth   DateTime?
  gender        String?   @db.VarChar(20)
  maritalStatus String?   @db.VarChar(20)
  cnic          String?   @db.VarChar(20)

  // Emergency Contact
  emergencyContactName     String? @db.VarChar(100)
  emergencyContactRelation String? @db.VarChar(50)
  emergencyContactPhone    String? @db.VarChar(20)

  status    String   @default("active") @db.VarChar(20) // active | inactive
  terminationDate   DateTime?
  terminationReason String?
  rehireDate        DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?      @relation(fields: [userId], references: [id])
  outlet       Outlet?    @relation(fields: [outletId], references: [id])
  supervisor   Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates Employee[] @relation("EmployeeSupervisor")
  paymentLogs  PaymentLog[]

  @@map("employees")
}

// =============================================
// PHASE 2: Settings
// =============================================

model Settings {
  id                String   @id @default(uuid())
  outletId          String?
  restaurantName    String?  @db.VarChar(100)
  currency          String   @default("Rs.") @db.VarChar(10)
  taxRate           Decimal  @default(16) @db.Decimal(5, 2)
  taxName           String   @default("GST") @db.VarChar(20)
  phone             String?  @db.VarChar(20)
  email             String?  @db.VarChar(100)
  address           String?
  receiptHeader     String?
  tableManagement   Boolean  @default(true)
  onlineOrders      Boolean  @default(true)
  reservations      Boolean  @default(false)
  selfOrderConfig   Json     @default("{}")
  websiteConfig     Json     @default("{}")
  reservationConfig Json     @default("{}")
  shiftConfig       Json     @default("{}")
  graceMinutes      Int      @default(15)
  paymentMethods    String[] @default(["Cash", "Credit Card", "Account", "JazzCash", "EasyPaisa"])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  outlet Outlet? @relation(fields: [outletId], references: [id])

  @@map("settings")
}

// =============================================
// PHASE 3: Menu Management
// =============================================

model FoodCategory {
  id           String @id @default(uuid())
  name         String @db.VarChar(100)
  displayOrder Int    @default(0)
  status       String @default("active") @db.VarChar(20)

  // Relations
  menuItems FoodMenuItem[]

  @@map("food_categories")
}

model FoodMenuItem {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  code           String?  @unique @db.VarChar(20)
  categoryId     String?
  price          Decimal  @db.Decimal(10, 2)
  dineInPrice    Decimal? @db.Decimal(10, 2)
  takeAwayPrice  Decimal? @db.Decimal(10, 2)
  deliveryPrice  Decimal? @db.Decimal(10, 2)
  foodpandaPrice Decimal? @db.Decimal(10, 2)
  costPrice      Decimal  @default(0) @db.Decimal(10, 2) // recipe-derived food cost, snapshotted at save time
  // Portions-remaining threshold at/below which POS flags this dish "Low Stock".
  // Was hardcoded to 5 for every dish in foodAvailability.ts; a slow-moving item
  // and a bestseller need very different warning points, so it is per-dish now.
  // Applies to every variant of the item (availability is computed per variant).
  lowStockAlert  Int      @default(5)
  available      Boolean  @default(true)
  image          String?
  tags           String[]
  cookingTime    Int      @default(0)
  mealTypeIds    String[]
  createdAt      DateTime @default(now())

  // Relations
  category   FoodCategory?      @relation(fields: [categoryId], references: [id])
  variants   FoodMenuVariant[]
  recipes    FoodRecipe[]
  modifiers  MenuItemModifier[]
  orderItems OrderItem[]

  @@map("food_menu_items")
}

model FoodMenuVariant {
  id             String   @id @default(uuid())
  menuItemId     String
  name           String   @db.VarChar(100)
  price          Decimal  @db.Decimal(10, 2)
  dineInPrice    Decimal? @db.Decimal(10, 2)
  takeAwayPrice  Decimal? @db.Decimal(10, 2)
  deliveryPrice  Decimal? @db.Decimal(10, 2)
  foodpandaPrice Decimal? @db.Decimal(10, 2)
  costPrice      Decimal  @default(0) @db.Decimal(10, 2) // recipe-derived food cost for this variant, snapshotted at save time
  displayOrder   Int      @default(0)

  // Relations
  menuItem FoodMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  recipes  FoodRecipe[]

  @@map("food_menu_variants")
}

model Modifier {
  id           String  @id @default(uuid())
  name         String  @db.VarChar(100)
  price        Decimal @default(0) @db.Decimal(10, 2)  // selling price (what customer pays)
  type         String? @db.VarChar(20) // addon, removal
  status       String  @default("active") @db.VarChar(20)
  ingredientId String? // if set, this modifier is backed by an ingredient

  // Relations
  menuItems  MenuItemModifier[]
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])

  @@map("modifiers")
}

model MenuItemModifier {
  id            String  @id @default(uuid())
  menuItemId    String
  modifierId    String
  variantIds    String[]  // kept for backward compat; empty = all variants
  qty           Decimal   @default(1) @db.Decimal(10, 4)  // qty of ingredient used per serving (simple pricing)
  sellingPrice  Decimal   @default(0) @db.Decimal(10, 2)  // selling price override (simple pricing)
  variantConfig Json      @default("[]")                  // [{variantId, qty, sellingPrice}] for variant pricing

  // Relations
  menuItem FoodMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifier Modifier     @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierId])
  @@map("menu_item_modifiers")
}

// =============================================
// PHASE 4: Inventory & Ingredients
// =============================================

model IngredientCategory {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  description String?
  status      String  @default("active") @db.VarChar(20)

  // Relations
  ingredients Ingredient[]

  @@map("ingredient_categories")
}

model IngredientUnit {
  id     String @id @default(uuid())
  name   String @db.VarChar(50)
  symbol String @default("") @db.VarChar(10)
  status String @default("active") @db.VarChar(20)

  // Relations
  ingredients     Ingredient[]
  recipeUsages    FoodRecipe[]
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")

  @@map("ingredient_units")
}

model UnitConversion {
  id         String  @id @default(uuid())
  fromUnitId String
  toUnitId   String
  factor     Decimal @db.Decimal(18, 8)

  fromUnit IngredientUnit @relation("FromUnit", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit   IngredientUnit @relation("ToUnit", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId])
  @@map("unit_conversions")
}

model Ingredient {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  brand          String?  @db.VarChar(100)
  categoryId     String?
  unitId         String?
  purchasePrice  Decimal? @db.Decimal(10, 2)
  currentStock   Decimal  @default(0) @db.Decimal(10, 3)
  lowStockLevel  Decimal  @default(0) @db.Decimal(10, 3)
  status         String   @default("active") @db.VarChar(20)
  shelfLifeHours Int? // null = normal; set (e.g. 8) = short-life ingredient (dough) with batch + countdown tracking
  supplierId     String?  // Associated vendor
  outletId       String?

  // Relations
  outlet               Outlet?               @relation(fields: [outletId], references: [id])
  category             IngredientCategory?   @relation(fields: [categoryId], references: [id])
  unit                 IngredientUnit?       @relation(fields: [unitId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  recipes              FoodRecipe[]
  stockAdjustments     StockAdjustment[]
  stockTakeItems       StockTakeItem[]
  warehouseStock       WarehouseStock[]
  challanItems         StockChallanItem[]
  demandItems          StockDemandItem[]
  purchaseRequestItems PurchaseRequestItem[]
  stockBatches         StockBatch[]
  outletIngredientSuppliers OutletIngredientSupplier[]
  modifiers            Modifier[]

  @@map("ingredients")
}

model FoodRecipe {
  id               String  @id @default(uuid())
  menuItemId       String
  variantId        String?
  ingredientId     String?
  productionItemId String?
  qtyPerUnit       Decimal @db.Decimal(10, 4)
  usageUnitId      String?

  // Relations
  menuItem       FoodMenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variant        FoodMenuVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredient     Ingredient?      @relation(fields: [ingredientId], references: [id])
  productionItem ProductionItem?  @relation(fields: [productionItemId], references: [id])
  usageUnit      IngredientUnit?  @relation(fields: [usageUnitId], references: [id])

  @@map("food_recipes")
}

model PreMadeFood {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(100)
  unit          String?  @db.VarChar(20)
  currentStock  Decimal  @default(0) @db.Decimal(10, 3)
  lowStockLevel Decimal  @default(0) @db.Decimal(10, 3)
  costPerUnit   Decimal? @db.Decimal(10, 2)
  status        String   @default("active") @db.VarChar(20)

  @@map("pre_made_food")
}

model StockAdjustment {
  id           String   @id @default(uuid())
  ingredientId String
  type         String   @db.VarChar(20) // add, deduct, damage, correction
  quantity     Decimal  @db.Decimal(10, 3)
  reason       String?
  adjustedById String?
  warehouseId  String?
  outletId     String?
  date         DateTime @default(now())

  // Relations
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  adjustedBy User?      @relation(fields: [adjustedById], references: [id])
  warehouse  Warehouse? @relation(fields: [warehouseId], references: [id])
  outlet     Outlet?    @relation(fields: [outletId], references: [id])

  @@index([ingredientId])
  @@index([warehouseId, type, date])
  @@index([outletId])
  @@map("stock_adjustments")
}

model StockTake {
  id                 String    @id @default(uuid())
  reference          String?   @unique @db.VarChar(20)
  date               DateTime  @db.Date
  status             String    @default("active") @db.VarChar(20)
  countedBy          String?   @db.VarChar(100)
  totalVarianceValue Decimal   @default(0) @db.Decimal(10, 2)
  notes              String?
  warehouseId        String?
  outletId           String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  // Relations
  items     StockTakeItem[]
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id])
  outlet    Outlet?         @relation(fields: [outletId], references: [id])

  @@index([outletId])
  @@map("stock_takes")
}

model StockTakeItem {
  id            String   @id @default(uuid())
  stockTakeId   String
  ingredientId  String
  systemQty     Decimal? @db.Decimal(10, 3)
  countedQty    Decimal? @db.Decimal(10, 3)
  variance      Decimal? @db.Decimal(10, 3)
  varianceValue Decimal? @db.Decimal(10, 2)

  // Relations
  stockTake  StockTake  @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("stock_take_items")
}

model Production {
  id               String   @id @default(uuid())
  itemName         String?  @db.VarChar(100)
  quantity         Decimal? @db.Decimal(10, 3)
  unit             String?  @db.VarChar(20)
  producedBy       String?  @db.VarChar(100)
  outletId         String?
  date             DateTime @default(now())
  notes            String?
  shelfLifeMinutes Int?

  // Relations
  outlet           Outlet?  @relation(fields: [outletId], references: [id])

  @@index([outletId])
  @@map("productions")
}

model Transfer {
  id            String   @id @default(uuid())
  fromOutletId  String?
  toOutletId    String?
  itemName      String?  @db.VarChar(100)
  quantity      Decimal? @db.Decimal(10, 3)
  unit          String?  @db.VarChar(20)
  status        String   @default("pending") @db.VarChar(20)
  transferredBy String?  @db.VarChar(100)
  date          DateTime @default(now())
  notes         String?

  // Relations
  fromOutlet Outlet? @relation("TransferFrom", fields: [fromOutletId], references: [id])
  toOutlet   Outlet? @relation("TransferTo", fields: [toOutletId], references: [id])

  @@map("transfers")
}

model WasteRecord {
  id          String   @id @default(uuid())
  itemName    String?  @db.VarChar(100)
  quantity    Decimal? @db.Decimal(10, 3)
  unit        String?  @db.VarChar(20)
  reason      String?
  cost        Decimal? @db.Decimal(10, 2)
  recordedBy  String?  @db.VarChar(100)
  outletId    String?
  warehouseId String?
  purchaseId  String?
  orderId     String?
  date        DateTime @default(now())

  // Relations
  outlet    Outlet?    @relation(fields: [outletId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  purchase  Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([warehouseId])
  @@index([purchaseId])
  @@index([orderId])
  @@map("waste_records")
}

// =============================================
// PHASE W1: Warehouse Management
// =============================================

model Warehouse {
  id        String        @id @default(uuid())
  name      String        @db.VarChar(100)
  code      String        @unique @db.VarChar(20)
  address   String        @default("")
  type      WarehouseType
  outletId  String?
  managerId String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  // Relations
  outlet           Outlet?           @relation(fields: [outletId], references: [id])
  manager          User?             @relation("WarehouseManager", fields: [managerId], references: [id])
  warehouseStock   WarehouseStock[]
  purchases        Purchase[]
  stockAdjustments StockAdjustment[]
  stockTakes       StockTake[]
  challansFrom     StockChallan[]    @relation("ChallanFrom")
  challansTo       StockChallan[]    @relation("ChallanTo")
  demandsRequested StockDemand[]     @relation("DemandRequesting")
  demandsToSupply  StockDemand[]     @relation("DemandSupplying")
  purchaseRequests         PurchaseRequest[]
  stockBatches             StockBatch[]
  productionBatches        ProductionBatch[]
  productionWarehouseStock ProductionWarehouseStock[]
  wasteRecords             WasteRecord[]

  @@index([outletId, type])
  @@map("warehouses")
}

model ProductionItem {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  unit           String   @db.VarChar(20)
  shelfLifeHours Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  productionBatches        ProductionBatch[]
  productionWarehouseStock ProductionWarehouseStock[]
  foodRecipes              FoodRecipe[]

  @@map("production_items")
}

model ProductionBatch {
  id               String   @id @default(uuid())
  productionItemId String
  warehouseId      String
  batchQty         Decimal  @db.Decimal(10, 3)
  remainingQty     Decimal  @db.Decimal(10, 3)
  shelfLifeMinutes Int?
  unitCost         Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  productionItem ProductionItem @relation(fields: [productionItemId], references: [id])
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])

  @@index([productionItemId, warehouseId])
  @@map("production_batches")
}

model ProductionWarehouseStock {
  id               String   @id @default(uuid())
  productionItemId String
  warehouseId      String
  currentStock     Decimal  @default(0) @db.Decimal(10, 3)
  updatedAt        DateTime @updatedAt

  productionItem ProductionItem @relation(fields: [productionItemId], references: [id])
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([productionItemId, warehouseId])
  @@map("production_warehouse_stock")
}

model StockBatch {
  id           String    @id @default(uuid())
  warehouseId  String
  ingredientId String
  purchaseId   String?
  batchQty         Decimal   @db.Decimal(10, 3)
  remainingQty     Decimal   @db.Decimal(10, 3)
  expiryDate       DateTime? @db.Date
  shelfLifeMinutes Int? // per-batch expiry override (minutes from createdAt); null = use ingredient.shelfLifeHours
  unitCost         Decimal?  @db.Decimal(10, 2) // cost per produced unit = (sum of consumed ingredient costs) / qty; used to value waste
  createdAt        DateTime  @default(now())

  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  purchase   Purchase?  @relation(fields: [purchaseId], references: [id])

  @@index([warehouseId, ingredientId])
  @@index([ingredientId])
  @@index([expiryDate])
  @@index([purchaseId])
  @@map("stock_batches")
}

model WarehouseStock {
  id            String   @id @default(uuid())
  warehouseId   String
  ingredientId  String
  currentStock  Decimal  @default(0) @db.Decimal(10, 3)
  lowStockLevel Decimal  @default(0) @db.Decimal(10, 3)
  updatedAt     DateTime @updatedAt

  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([warehouseId, ingredientId])
  @@map("warehouse_stock")
}

model StockChallan {
  id              String        @id @default(uuid())
  challanNo       String        @unique @db.VarChar(30)
  fromWarehouseId String
  toWarehouseId   String
  status          ChallanStatus @default(PENDING)
  notes           String?
  shippingCost    Decimal?      @db.Decimal(10, 2)
  miscAmount      Decimal?      @db.Decimal(10, 2)
  tax             Decimal?      @db.Decimal(10, 2)
  subtotal        Decimal?      @db.Decimal(10, 2)
  total           Decimal?      @db.Decimal(10, 2)
  paid            Decimal       @default(0) @db.Decimal(10, 2)
  due             Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus   String?       @db.VarChar(20) // 'paid' | 'partial' | 'unpaid' — set only for MAIN→BRANCH challans
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  dispatchedById  String?
  receivedById    String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  fromWarehouse Warehouse             @relation("ChallanFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse             @relation("ChallanTo", fields: [toWarehouseId], references: [id])
  dispatchedBy  User?                 @relation("ChallanDispatched", fields: [dispatchedById], references: [id])
  receivedBy    User?                 @relation("ChallanReceived", fields: [receivedById], references: [id])
  createdBy     User?                 @relation("ChallanCreated", fields: [createdById], references: [id])
  items         StockChallanItem[]
  demand        StockDemand?
  settlements   WarehouseSettlement[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@index([createdAt])
  @@map("stock_challans")
}

model StockChallanItem {
  id           String   @id @default(uuid())
  challanId    String
  ingredientId String
  qty          Decimal  @db.Decimal(10, 3)
  receivedQty  Decimal? @db.Decimal(10, 3)
  wasteQty     Decimal? @db.Decimal(10, 3)
  wasteReason  String?
  unitPrice    Decimal? @db.Decimal(10, 2) // snapshot of Ingredient.purchasePrice at receive time (MAIN→BRANCH only)

  challan    StockChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  ingredient Ingredient   @relation(fields: [ingredientId], references: [id])

  @@map("stock_challan_items")
}

model StockDemand {
  id              String       @id @default(uuid())
  demandNo        String       @unique @db.VarChar(30)
  requestingWHId  String
  supplyingWHId   String
  status          DemandStatus @default(PENDING)
  notes           String?
  rejectionReason String?
  challanId       String?      @unique
  approvedAt      DateTime?
  fulfilledAt     DateTime?
  rejectedAt      DateTime?
  requestedById   String?
  approvedById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  requestingWH Warehouse         @relation("DemandRequesting", fields: [requestingWHId], references: [id])
  supplyingWH  Warehouse         @relation("DemandSupplying", fields: [supplyingWHId], references: [id])
  requestedBy  User?             @relation("DemandRequested", fields: [requestedById], references: [id])
  approvedBy   User?             @relation("DemandApproved", fields: [approvedById], references: [id])
  challan      StockChallan?     @relation(fields: [challanId], references: [id])
  items        StockDemandItem[]

  @@index([requestingWHId])
  @@index([supplyingWHId])
  @@index([status])
  @@index([createdAt])
  @@map("stock_demands")
}

model StockDemandItem {
  id             String   @id @default(uuid())
  demandId       String
  ingredientId   String
  requestedQty   Decimal  @db.Decimal(10, 3)
  approvedQty    Decimal? @db.Decimal(10, 3)
  stockAtRequest Decimal? @db.Decimal(10, 3)

  demand     StockDemand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  ingredient Ingredient  @relation(fields: [ingredientId], references: [id])

  @@map("stock_demand_items")
}

model WarehouseSettlement {
  id           String   @id @default(uuid())
  outletId     String
  type         String   @db.VarChar(10) // 'CHARGE' (from a received MAIN→BRANCH transfer) | 'PAYMENT' (manual settlement)
  amount       Decimal  @db.Decimal(10, 2) // always positive; sign implied by type
  balanceAfter Decimal  @db.Decimal(10, 2) // Outlet.dueToMain snapshot right after this entry
  challanId    String?  // set only for CHARGE rows
  notes        String?
  recordedById String?
  createdAt    DateTime @default(now())

  outlet     Outlet        @relation(fields: [outletId], references: [id])
  challan    StockChallan? @relation(fields: [challanId], references: [id])
  recordedBy User?         @relation("SettlementRecordedBy", fields: [recordedById], references: [id])

  @@index([outletId])
  @@index([createdAt])
  @@map("warehouse_settlements")
}

// =============================================
// PHASE 5: Orders & POS
// =============================================

enum OrderType {
  DINE_IN    @map("Dine In")
  TAKE_AWAY  @map("Take Away")
  DELIVERY   @map("Delivery")
  ONLINE     @map("Online")
  SELF_ORDER @map("Self Order")
  FOODPANDA  @map("Foodpanda")
  WALKIN     @map("Walk-in")
}

enum OrderStatus {
  PENDING   @map("pending")
  PREPARING @map("preparing")
  READY     @map("ready")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
  SCHEDULED @map("scheduled")
}

enum WarehouseType {
  MAIN    @map("main")
  BRANCH  @map("branch")
  KITCHEN @map("kitchen")
}

enum ChallanStatus {
  PENDING    @map("pending")
  DISPATCHED @map("dispatched")
  RECEIVED   @map("received")
  CANCELLED  @map("cancelled")
}

enum DemandStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  FULFILLED @map("fulfilled")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @db.VarChar(20)
  customerId      String?
  customerName    String?     @db.VarChar(100)
  phone           String?     @db.VarChar(20)
  type            OrderType   @default(WALKIN)
  subtotal        Decimal     @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING)
  paymentMethod   String?
  date            DateTime    @db.Date
  time            String?     @db.VarChar(20)
  staffId         String?
  staffName       String?     @db.VarChar(100)
  tableNumber     Int?
  deliveryAddress String?
  riderId         String?
  outletId        String?
  // Future Sale fields
  isFutureSale    Boolean     @default(false)
  scheduledDate   DateTime?   @db.Date
  scheduledTime   String?     @db.VarChar(20)
  futureNotes     String?
  advancePayment  Decimal     @default(0) @db.Decimal(10, 2)
  // Enhanced POS fields
  isUrgent        Boolean     @default(false)
  customerType    String?     @db.VarChar(20) // walk-in, regular, corporate, vip
  orderSource     String?     @db.VarChar(20) // pos, self-order, website, foodpanda, phone
  cashApproved    Boolean     @default(false)
  guestCount      Int?
  acceptedById    String?
  acceptedByName  String?     @db.VarChar(100)
  rejectionReason String?
  // Order-level discount (ORDER_DISCOUNT deal — promo code or minimum-spend),
  // never a formal relation: same reasoning as OrderItem.dealId, a deleted
  // deal must not break historical orders/receipts.
  appliedDealId   String?
  appliedDealCode String?     @db.VarChar(20)
  appliedDealName String?     @db.VarChar(100)
  settlementId           String?
  cashierSettlementId    String?  // tracks cashier's advance portion settlement
  riderSettlementId      String?  // tracks rider's COD portion settlement
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  customer      Customer?              @relation(fields: [customerId], references: [id])
  staff         User?                  @relation(fields: [staffId], references: [id])
  acceptedBy    User?                  @relation("OrderAcceptedBy", fields: [acceptedById], references: [id])
  rider         DeliveryRider?         @relation(fields: [riderId], references: [id])
  outlet        Outlet?                @relation("OrderOutlet", fields: [outletId], references: [id])
  items         OrderItem[]
  modifications OrderModificationLog[]
  deliveries    DeliveryAssignment[]
  loyaltyTx     LoyaltyTransaction[]
  wasteRecords  WasteRecord[]
  cancellationRequests OrderCancellationRequest[]
  staffPenalties       StaffPenalty[]
  kitchenProgress      OrderKitchenProgress[]
  kitchenDealProgress  OrderKitchenDealProgress[]
  settlement           CashSettlement?        @relation(fields: [settlementId], references: [id])
  cashierSettlement    CashSettlement?        @relation("CashierSettledOrders", fields: [cashierSettlementId], references: [id])
  riderSettlement      CashSettlement?        @relation("RiderSettledOrders", fields: [riderSettlementId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([type])
  @@index([date])
  @@index([customerId])
  @@index([riderId])
  @@index([outletId, createdAt])
  @@index([appliedDealId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  menuItemId  String?
  variantId   String?
  name        String   @db.VarChar(200)
  price       Decimal  @db.Decimal(10, 2)
  qty         Int
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  modifiers    String[]
  modifierIds  Json     @default("[]") // [{modifierId, qty}] for stock deduction
  cookingTime Int?
  notes       String?
  status      String   @default("active") @db.VarChar(20) // active | cancelled
  dealId      String? // set when this line was generated from a Deal
  dealName    String?  @db.VarChar(100)
  dealLineId  String? // groups the multiple OrderItem rows that came from one deal selection
  // Stable per-dish key within one deal redemption (`${dealLineId}#${ordinal}`), server-computed
  // from submission order — never client-trusted. Lets the kitchen accept/prepare/ready each dish
  // of a deal independently instead of the whole redemption together. Survives an order edit
  // (items are deleted + recreated) because it's derived from dealLineId, which the frontend
  // preserves verbatim when an order is reloaded into the cart — unlike this row's own id.
  // Null for a plain (non-deal) item, which keeps using the shared per-kitchen OrderKitchenProgress
  // ticket exactly as before.
  dealItemKey String?  @db.VarChar(140)

  // Relations
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem FoodMenuItem? @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
  @@index([dealId])
  @@map("order_items")
}

model OrderKitchenProgress {
  id        String   @id @default(uuid())
  orderId   String
  kitchenId String
  status    String   @default("pending") @db.VarChar(20) // pending | preparing | ready
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchen Kitchen @relation(fields: [kitchenId], references: [id])

  @@unique([orderId, kitchenId])
  @@map("order_kitchen_progress")
}

// Per-dish kitchen status for a deal redemption's items — a sibling to
// OrderKitchenProgress (which still tracks every non-deal item as one shared
// ticket per order+kitchen, unchanged). Keyed by OrderItem.dealItemKey rather
// than an OrderItem id/FK because updateOrder deletes and recreates every
// OrderItem row on any items edit; dealItemKey survives that round-trip.
model OrderKitchenDealProgress {
  id          String   @id @default(uuid())
  orderId     String
  kitchenId   String
  dealItemKey String   @db.VarChar(140)
  status      String   @default("pending") @db.VarChar(20) // pending | preparing | ready
  updatedAt   DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchen Kitchen @relation(fields: [kitchenId], references: [id])

  @@unique([orderId, kitchenId, dealItemKey])
  @@map("order_kitchen_deal_progress")
}

model OrderModificationLog {
  id        String   @id @default(uuid())
  orderId   String
  action    String   @db.VarChar(30) // item_added, item_removed, qty_changed, etc.
  detail    String?
  staff     String?  @db.VarChar(100)
  timestamp DateTime @default(now())
  refundAmount   Decimal? @db.Decimal(10, 2)
  refundMethod   String?  @db.VarChar(20) // cash | card | online | none
  authorizedById String?

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorizedBy User?  @relation("OrderCancelAuthorizedBy", fields: [authorizedById], references: [id])

  @@map("order_modification_logs")
}

model OrderCancellationRequest {
  id                String    @id @default(uuid())
  orderId           String
  outletId          String?
  itemIds           String[]                                    // empty = full-order cancel
  reason            String    @db.VarChar(255)
  refundAmount      Decimal   @db.Decimal(10, 2)
  refundMethod      String    @db.VarChar(20)                   // cash | card | online | none
  newSubtotal       Decimal?  @db.Decimal(10, 2)                 // partial-cancel recomputed totals
  newTax            Decimal?  @db.Decimal(10, 2)
  newTotal          Decimal?  @db.Decimal(10, 2)
  requestedById     String
  approverId        String                                      // chosen manager/admin (informational routing)
  responsibleUserId String?                                     // staff member to be penalised
  penaltyAmount     Decimal   @default(0) @db.Decimal(10, 2)
  status            String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  reviewedById      String?
  reviewNote        String?   @db.VarChar(255)
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())

  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy     User   @relation("CancelReqRequestedBy", fields: [requestedById], references: [id])
  approver        User   @relation("CancelReqApprover", fields: [approverId], references: [id])
  responsibleUser User?  @relation("CancelReqResponsible", fields: [responsibleUserId], references: [id])
  reviewedBy      User?  @relation("CancelReqReviewedBy", fields: [reviewedById], references: [id])

  @@index([outletId, status])
  @@index([approverId, status])
  @@map("order_cancellation_requests")
}

model StaffPenalty {
  id           String   @id @default(uuid())
  userId       String                                          // login account penalised (My Portal keys on this)
  outletId     String?
  amount       Decimal  @db.Decimal(10, 2)
  reason       String   @db.VarChar(255)                       // e.g. "Order ORD-123 cancelled — Missing Item"
  type         String   @default("order_cancellation") @db.VarChar(30)
  date         String   @db.VarChar(10)                        // "YYYY-MM-DD" (PKT) — drives payroll period inclusion
  orderId      String?
  requestId    String?                                         // OrderCancellationRequest.id
  paymentLogId String?                                         // stamped when paid, so payroll never double-counts
  createdAt    DateTime @default(now())

  user  User   @relation("StaffPenaltyUser", fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, paymentLogId])
  @@index([outletId])
  @@map("staff_penalties")
}

model CashSettlement {
  id              String   @id @default(uuid())
  settlementNo    String   @unique @db.VarChar(30)
  outletId        String?
  staffId         String
  staffName       String   @db.VarChar(100)
  staffRole       String   @db.VarChar(50)
  settledById     String
  settledByName   String   @db.VarChar(100)
  
  expectedCash    Decimal  @db.Decimal(10, 2)
  expectedCard    Decimal  @db.Decimal(10, 2)
  expectedOnline  Decimal  @db.Decimal(10, 2)
  totalExpected   Decimal  @db.Decimal(10, 2)

  actualCash      Decimal  @db.Decimal(10, 2)
  actualCard      Decimal  @db.Decimal(10, 2)
  actualOnline    Decimal  @db.Decimal(10, 2)
  totalActual     Decimal  @db.Decimal(10, 2)

  cashDifference  Decimal  @default(0) @db.Decimal(10, 2)
  paymentBreakdown Json?
  notes           String?  @db.VarChar(255)

  createdAt       DateTime @default(now())

  outlet    Outlet? @relation(fields: [outletId], references: [id])
  staff     User    @relation("StaffSettlements", fields: [staffId], references: [id])
  settledBy User    @relation("ManagerApprovedSettlements", fields: [settledById], references: [id])
  orders         Order[]
  cashierOrders  Order[]   @relation("CashierSettledOrders")
  riderOrders    Order[]   @relation("RiderSettledOrders")

  @@index([outletId, createdAt])
  @@index([staffId])
  @@map("cash_settlements")
}

model Kitchen {
  id                 String   @id @default(uuid())
  name               String   @db.VarChar(100)
  assignedCategories String[]
  status             String   @default("active") @db.VarChar(20)

  orderProgress OrderKitchenProgress[]
  orderDealProgress OrderKitchenDealProgress[]

  @@map("kitchens")
}

// =============================================
// PHASE 6: Customers & Loyalty
// =============================================

model Customer {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(100)
  phone           String?   @db.VarChar(20)
  email           String?   @db.VarChar(100)
  address         String?
  customerType    String    @default("walk-in") @db.VarChar(20) // walk-in, regular, corporate, vip
  loyaltyPoints   Int       @default(0)
  customPriceList String?   @db.VarChar(50)
  totalOrders     Int       @default(0)
  totalSpent      Decimal   @default(0) @db.Decimal(12, 2)
  outstandingDue  Decimal   @default(0) @db.Decimal(10, 2)
  lastOrder       DateTime? @db.Date
  createdAt       DateTime  @default(now())
  outletId        String?   @db.VarChar(36)

  // Relations
  outlet        Outlet?        @relation(fields: [outletId], references: [id])
  orders        Order[]
  loyaltyMember LoyaltyMember?

  @@map("customers")
}

model LoyaltySettings {
  id              String  @id @default(uuid())
  outletId        String?
  pointsPerAmount Int     @default(1)
  amountPerPoint  Decimal @default(100) @db.Decimal(10, 2)
  signupBonus     Int     @default(100)
  birthdayBonus   Int     @default(50)
  tiers           Json    @default("[]")

  // Relations
  outlet Outlet? @relation(fields: [outletId], references: [id])

  @@map("loyalty_settings")
}

model LoyaltyMember {
  id              String   @id @default(uuid())
  customerId      String   @unique
  phone           String?  @db.VarChar(20)
  totalPoints     Int      @default(0)
  availablePoints Int      @default(0)
  tier            String   @default("Bronze") @db.VarChar(30)
  joinedDate      DateTime @default(now()) @db.Date

  // Relations
  customer     Customer             @relation(fields: [customerId], references: [id])
  transactions LoyaltyTransaction[]

  @@map("loyalty_members")
}

model LoyaltyReward {
  id             String  @id @default(uuid())
  name           String? @db.VarChar(100)
  pointsRequired Int
  type           String  @db.VarChar(30) // freeItem, percentDiscount, fixedDiscount
  value          String? @db.VarChar(100)
  isActive       Boolean @default(true)

  @@map("loyalty_rewards")
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  memberId    String
  type        String   @db.VarChar(10) // earn, redeem
  points      Int
  description String?
  orderId     String?
  date        DateTime @default(now()) @db.Date

  // Relations
  member LoyaltyMember @relation(fields: [memberId], references: [id])
  order  Order?        @relation(fields: [orderId], references: [id])

  @@map("loyalty_transactions")
}

// =============================================
// PHASE 7: Financial
// =============================================

model Supplier {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  company        String?  @db.VarChar(100)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(100)
  totalPurchases Decimal  @default(0) @db.Decimal(12, 2)
  totalDue       Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  outletId       String?

  // Relations
  outlet           Outlet?           @relation(fields: [outletId], references: [id])
  purchases        Purchase[]
  ingredients      Ingredient[]
  purchaseRequests PurchaseRequest[]
  purchasePayments PurchasePayment[]
  outletIngredientSuppliers OutletIngredientSupplier[]

  @@map("suppliers")
}

model Purchase {
  id            String   @id @default(uuid())
  supplierId    String?
  warehouseId   String?
  outletId      String?
  invoiceNumber String?  @db.VarChar(30)
  items         Json // [{name, qty, unit, price, total}]
  subtotal      Decimal? @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  tax           Decimal? @db.Decimal(10, 2)
  shippingCost  Decimal? @db.Decimal(10, 2)
  miscAmount    Decimal? @db.Decimal(10, 2)
  total         Decimal? @db.Decimal(10, 2)
  paid          Decimal  @default(0) @db.Decimal(10, 2)
  due           Decimal  @default(0) @db.Decimal(10, 2)
  status        String   @default("pending") @db.VarChar(20)
  date          DateTime @default(now()) @db.Date
  notes         String?
  createdAt     DateTime @default(now())

  purchaseRequestId String? @unique
  createdById       String?

  // Relations
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])
  outlet          Outlet?          @relation(fields: [outletId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  createdBy       User?            @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  stockBatches    StockBatch[]
  wasteRecords    WasteRecord[]
  paymentHistory  PurchasePayment[]
  supplierDues    Json? // [{supplierId, supplierName, total, paid, due, status}]

  @@index([outletId])
  @@map("purchases")
}

model Expense {
  id            String   @id @default(uuid())
  category      String?  @db.VarChar(50)
  description   String?
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String?
  reference     String?  @db.VarChar(50)
  receipt       Boolean  @default(false)
  date          DateTime @default(now()) @db.Date
  recordedBy    String?  @db.VarChar(100)
  outletId      String?
  createdAt     DateTime @default(now())

  // Relations
  outlet        Outlet?  @relation(fields: [outletId], references: [id])

  @@index([outletId])
  @@map("expenses")
}

// =============================================
// PHASE 8: Delivery
// =============================================

model DeliveryRider {
  id               String  @id @default(uuid())
  userId           String? @unique // links to User account (role=Rider)
  name             String  @db.VarChar(100)
  phone            String? @db.VarChar(20)
  isAvailable      Boolean @default(true)
  activeDeliveries Int     @default(0)
  status           String  @default("available") @db.VarChar(20) // available, on_delivery, offline

  // Relations
  user       User?                @relation(fields: [userId], references: [id])
  orders     Order[]
  deliveries DeliveryAssignment[]

  @@map("delivery_riders")
}

model DeliveryAssignment {
  id              String    @id @default(uuid())
  orderId         String
  riderId         String
  status          String    @default("pending") @db.VarChar(20) // pending, accepted, dispatched, delivered, returned
  assignedAt      DateTime  @default(now())
  acceptedAt      DateTime?
  deliveredAt     DateTime?
  estimatedTime   Int? // minutes
  customerAddress String?
  customerPhone   String?   @db.VarChar(20)
  notes           String?
  // Amount collection
  amountToCollect Decimal?  @db.Decimal(10, 2) // order total (cash on delivery)
  collectedAt     DateTime? // when manager collected cash from rider
  collectedBy     String?   @db.VarChar(100) // name of manager who collected
  commissionEarned Decimal  @default(0) @db.Decimal(10, 2)
  commissionRate   Decimal  @default(0) @db.Decimal(10, 2)

  // Relations
  order Order         @relation(fields: [orderId], references: [id])
  rider DeliveryRider @relation(fields: [riderId], references: [id])

  @@index([riderId, status, deliveredAt])
  @@index([orderId])
  @@index([status])
  @@map("delivery_assignments")
}

// =============================================
// PHASE 9: HR & Staff
// =============================================

model AttendanceRecord {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserAttendance", fields: [userId], references: [id])
  outletId  String
  outlet    Outlet    @relation(fields: [outletId], references: [id])
  date      String    // "YYYY-MM-DD" — one record per person per day
  clockIn   DateTime?
  clockOut  DateTime?
  status    String    @default("present") // present | late | absent
  overtimeMinutes Int @default(0) // minutes clocked out past the scheduled shift end
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, date])
  @@map("attendance_records")
}

model LeaveRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("UserLeaves", fields: [userId], references: [id])
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  leaveType    String   // casual | sick | annual | emergency
  startDate    String   // "YYYY-MM-DD"
  endDate      String
  totalDays    Int
  reason       String
  status       String   @default("pending") // pending | approved | rejected
  reviewedById String?
  reviewedBy   User?    @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedOn   String?
  reviewNote   String?
  appliedOn    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("leave_requests")
}

model LeaveBalance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  year       Int
  annual     Int      @default(14)
  annualUsed Int      @default(0)
  sick       Int      @default(6)
  sickUsed   Int      @default(0)
  casual     Int      @default(6)
  casualUsed Int      @default(0)
  halfday    Int      @default(10)
  halfdayUsed Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, year])
  @@map("leave_balances")
}

model StaffSchedule {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation("UserSchedules", fields: [userId], references: [id])
  outletId  String
  outlet    Outlet          @relation(fields: [outletId], references: [id])
  weekStart String          // "YYYY-MM-DD" always a Monday
  status    String          @default("draft") // draft | published
  shifts    ScheduleShift[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, weekStart])
  @@map("staff_schedules")
}

model ScheduleShift {
  id         String        @id @default(cuid())
  scheduleId String
  schedule   StaffSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayIndex   Int           // 0=Mon, 1=Tue, ..., 6=Sun
  shiftType  String        // morning | evening | night | off
  startTime  String?       // "09:00"
  endTime    String?       // "17:00"

  @@map("schedule_shifts")
}

model Shift {
  id               String    @id @default(uuid())
  shiftNumber      String?   @unique @db.VarChar(20)
  cashierId        String?
  cashierName      String?   @db.VarChar(100)
  outletId         String?
  openedAt         DateTime
  closedAt         DateTime?
  openingCash      Decimal?  @db.Decimal(10, 2)
  closingCash      Decimal?  @db.Decimal(10, 2)
  status           String    @default("open") @db.VarChar(10) // open, closed
  totalSales       Decimal   @default(0) @db.Decimal(10, 2)
  totalCashSales   Decimal   @default(0) @db.Decimal(10, 2)
  totalCardSales   Decimal   @default(0) @db.Decimal(10, 2)
  totalOnlineSales Decimal   @default(0) @db.Decimal(10, 2)
  orderCount       Int       @default(0)
  cancelledOrders  Int       @default(0)
  totalExpenses    Decimal   @default(0) @db.Decimal(10, 2)
  expectedCash     Decimal   @default(0) @db.Decimal(10, 2)
  cashDifference   Decimal?  @db.Decimal(10, 2)
  notes            String?

  // Relations
  cashier User?   @relation(fields: [cashierId], references: [id])
  outlet  Outlet? @relation(fields: [outletId], references: [id])

  @@index([outletId])
  @@map("shifts")
}

// =============================================
// PHASE 10: Advanced
// =============================================

enum DealType {
  COMBO          @map("combo")
  OPTION_COMBO   @map("option_combo")
  PERCENTAGE     @map("percentage")
  BUY_X_GET_Y    @map("buy_x_get_y")
  // Deprecated: superseded by PROMO_CODE/MIN_SPEND below. Kept only until the
  // backfill script (scripts/backfill-order-discount-split.ts) has migrated every
  // existing row and this member can be dropped in a follow-up destructive db push.
  ORDER_DISCOUNT @map("order_discount")
  // ORDER_DISCOUNT split in two: PROMO_CODE = customer types a code; MIN_SPEND =
  // auto-applies once the raw items subtotal clears `minSpend`. Both still share
  // minSpend/flatDiscount/discountPercent below.
  PROMO_CODE     @map("promo_code")
  MIN_SPEND      @map("min_spend")
}

model Deal {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(100)
  code           String?   @unique @db.VarChar(20)
  description    String?
  image          String?
  type           DealType
  // Fixed price for COMBO/OPTION_COMBO. Null for PERCENTAGE/BUY_X_GET_Y —
  // those discount existing item prices rather than sell at a flat bundle price.
  price          Decimal?  @db.Decimal(10, 2)
  dineInPrice    Decimal?  @db.Decimal(10, 2)
  takeAwayPrice  Decimal?  @db.Decimal(10, 2)
  deliveryPrice  Decimal?  @db.Decimal(10, 2)
  foodpandaPrice Decimal?  @db.Decimal(10, 2)
  // Per-channel discount-% overrides. Null on a channel = use the base figure.
  //   PERCENTAGE  — replaces discountPercent for orders on that channel.
  //   BUY_X_GET_Y — how much of the free item the deal covers there; the base is
  //                 100 (genuinely free), so 50 means half price on that channel.
  // COMBO/OPTION_COMBO ignore these entirely — they vary by the flat *Price columns.
  dineInPercent    Decimal? @db.Decimal(5, 2)
  takeAwayPercent  Decimal? @db.Decimal(5, 2)
  deliveryPercent  Decimal? @db.Decimal(5, 2)
  foodpandaPercent Decimal? @db.Decimal(5, 2)
  isActive       Boolean   @default(true)
  status         String    @default("active") @db.VarChar(20) // active | archived
  outletIds      String[] // empty = chain-wide
  // Channel-availability gates, every deal type. Default true so every existing row
  // keeps working unchanged (same backwards-compat pattern as activeDays/[]).
  // Enforced both client-side (deal card filtering on POS/WaiterPanel/SelfOrder) and
  // server-side (revalidateDealLines, resolveOrderDiscount). No Foodpanda toggle —
  // matches POS's own 3-channel orderTypes; Foodpanda deals aren't gated here.
  availableDineIn   Boolean @default(true)
  availableTakeaway Boolean @default(true)
  availableDelivery Boolean @default(true)
  validFrom      DateTime  @db.Date
  validTo        DateTime? @db.Date
  // For COMBO/OPTION_COMBO/BUY_X_GET_Y: gates whether the whole deal is orderable.
  // For PERCENTAGE: optional — gates whether the discount is currently active
  // (e.g. a "happy hour" percentage deal).
  startTime      String?   @db.VarChar(10)
  endTime        String?   @db.VarChar(10)
  // Days of the week the deal runs, 0 = Sunday … 6 = Saturday. Empty = every
  // day, so an existing row keeps behaving exactly as it did. A startTime/
  // endTime window that crosses midnight belongs to the day it STARTED on —
  // a Saturday 23:00–03:00 deal is still live at 01:00 on Sunday.
  activeDays     Int[]

  // PERCENTAGE
  discountPercent      Decimal? @db.Decimal(5, 2)
  applicableItems      String[] // menuItemIds this discount applies to
  applicableCategories String[] // categoryIds this discount applies to (either list qualifies an item)

  // BUY_X_GET_Y — legacy single-item shape.
  //
  // A Buy X Get Y offer now holds any number of items on each side, in the
  // DealBogoItem relation below. These flat columns are kept in sync with the
  // FIRST item of each side so an older client still renders something sane,
  // and they remain the whole offer for rows written before the relation
  // existed (deal.pricing.ts's resolveBogoSides falls back to them).
  //
  // The *VariantId columns pin a side to one specific size/variant. Null means
  // "any variant", which lets a customer qualify with the cheapest size while
  // claiming the priciest one free — deal.revalidate.ts caps those giveaways at
  // the cheapest variant's price rather than rejecting the order.
  buyItemId    String?
  buyVariantId String?
  buyQty       Int?
  getItemId    String?
  getVariantId String?
  getQty       Int?

  // ORDER_DISCOUNT — a whole-order discount, not tied to specific items.
  // `code` (the column above) doubles as the mechanism switch: set = a
  // customer-entered promo code (e.g. OVEN20); null = auto-applies once
  // `minSpend` is met (a Minimum Spend deal). `minSpend` null/0 = no floor.
  // Exactly one of flatDiscount/discountPercent is set — flatDiscount is Rs.
  // off, discountPercent (the column above, shared with PERCENTAGE) is % off.
  // Both mechanisms (Promo Code and Minimum Spend) may use either.
  minSpend     Decimal? @db.Decimal(10, 2)
  flatDiscount Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  components   DealComponent[]
  optionGroups DealOptionGroup[]
  bogoItems    DealBogoItem[]

  @@map("deals")
}

model DealComponent {
  id           String  @id @default(uuid())
  dealId       String
  menuItemId   String
  variantId    String?
  qty          Int
  displayOrder Int     @default(0)

  // Relations
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_components")
}

/// One item on one side of a BUY_X_GET_Y offer. A deal may carry several of
/// each, so "Buy 1 Pizza + 1 Pasta, get 1 Drink + 1 Fries free" is one deal
/// rather than four. Every row on the BUY side must be bought for the offer to
/// apply; every row on the GET side is then given away.
model DealBogoItem {
  id           String   @id @default(uuid())
  dealId       String
  role         BogoRole
  menuItemId   String
  /// Pins this row to one size. Null = any size qualifies, and the giveaway is
  /// capped at the item's cheapest variant. Required on write when the item has
  /// variants (deal.controller.ts's assertBuyXGetYVariants).
  variantId    String?
  qty          Int      @default(1)
  displayOrder Int      @default(0)

  // Relations
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_bogo_items")
}

enum BogoRole {
  BUY @map("buy")
  GET @map("get")
}

model DealOptionGroup {
  id            String    @id @default(uuid())
  dealId        String
  label         String    @db.VarChar(100)
  minSelections Int
  maxSelections Int
  displayOrder  Int       @default(0)
  /// null = an OPTION_COMBO (Customizable) group — the only case before this column
  /// existed. Set (BUY|GET) = this group belongs to a BUY_X_GET_Y deal's side that the
  /// admin put in "Customizable" mode (see BogoRole below). A BUY_X_GET_Y side left in
  /// "Fixed" mode instead uses DealBogoItem rows, unrelated to this table — a single
  /// deal can have one side Fixed (DealBogoItem) and the other Customizable
  /// (DealOptionGroup rows tagged with bogoSide) at the same time.
  bogoSide      BogoRole?

  // Relations
  deal    Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  options DealOptionItem[]

  @@index([dealId])
  @@map("deal_option_groups")
}

model DealOptionItem {
  id           String  @id @default(uuid())
  groupId      String
  menuItemId   String
  variantId    String?
  extraPrice   Decimal @default(0) @db.Decimal(10, 2)
  displayOrder Int     @default(0)

  // Relations
  group DealOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("deal_option_items")
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique @db.VarChar(30)
  type           String    @db.VarChar(20) // percentage, fixed
  value          Decimal   @db.Decimal(10, 2)
  minOrderAmount Decimal   @default(0) @db.Decimal(10, 2)
  maxDiscount    Decimal?  @db.Decimal(10, 2)
  usageLimit     Int       @default(0)
  usedCount      Int       @default(0)
  validFrom      DateTime? @db.Date
  validTo        DateTime? @db.Date
  isActive       Boolean   @default(true)
  applicableTo   String    @default("all") @db.VarChar(20)
  createdAt      DateTime  @default(now())

  @@map("coupons")
}

model Reservation {
  id                String   @id @default(uuid())
  customerName      String   @db.VarChar(100)
  customerPhone     String?  @db.VarChar(20)
  date              DateTime @db.Date
  time              String   @db.VarChar(10)
  guestCount        Int      @default(1)
  tableId           String?
  tableNumber       String?  @db.VarChar(10)
  status            String   @default("pending") @db.VarChar(20) // pending, confirmed, seated, completed, cancelled, noShow
  specialRequests   String?
  source            String?  @db.VarChar(20) // phone, walkin, online
  outletId          String?
  bookingType       String   @default("table_reservation") @db.VarChar(30) // table_reservation, future_order
  orderType         String   @default("Dine In") @db.VarChar(30) // Dine In, Take Away, Delivery
  deliveryAddress   String?
  advancePaid       Decimal  @default(0) @db.Decimal(10, 2)
  paymentMethod     String?  @db.VarChar(50)
  paymentStatus     String   @default("unpaid") @db.VarChar(20) // unpaid, deposit_paid, fully_paid
  depositRef        String?  @db.VarChar(100)
  preOrderItems     Json?
  subtotal          Decimal  @default(0) @db.Decimal(10, 2)
  tax               Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal  @default(0) @db.Decimal(10, 2)
  orderId           String?
  isAdvanceAdjusted Boolean  @default(false)
  createdAt         DateTime @default(now())

  // Relations
  table  RestaurantTable? @relation(fields: [tableId], references: [id])
  outlet Outlet?          @relation(fields: [outletId], references: [id])

  @@index([outletId])
  @@map("reservations")
}

model RestaurantTable {
  id             String  @id @default(uuid())
  number         String  @db.VarChar(10)
  capacity       Int     @default(4)
  floor          String? @db.VarChar(50)
  shape          String? @db.VarChar(20) // square, round, rectangle
  status         String  @default("available") @db.VarChar(20)
  currentOrderId String?
  reservationId  String?
  outletId       String?
  occupiedById   String? @db.VarChar(50)
  occupiedByName String? @db.VarChar(100)
  occupiedByRole String? @db.VarChar(50)

  // Relations
  reservations Reservation[]
  outlet       Outlet?       @relation(fields: [outletId], references: [id])

  @@unique([outletId, number])
  @@index([outletId])
  @@map("restaurant_tables")
}

model MealType {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(50)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@map("meal_types")
}

model SmsHistory {
  id        String   @id @default(uuid())
  recipient String?  @db.VarChar(20)
  message   String?
  status    String?  @db.VarChar(20)
  sentAt    DateTime @default(now())

  @@map("sms_history")
}

// =============================================
// PHASE 11: Purchase Requests
// =============================================

model PurchaseRequest {
  id          String  @id @default(uuid())
  requestNo   String  @unique @db.VarChar(30)
  status      String  @default("PENDING") @db.VarChar(20)
  warehouseId String
  notes       String?
  supplierId  String? // Associated vendor for the request

  requestedById String
  createdAt     DateTime @default(now())

  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  rejectedAt      DateTime?

  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  requestedBy User                  @relation("PurchaseRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?                 @relation("PurchaseApprovedBy", fields: [approvedById], references: [id])
  supplier    Supplier?             @relation(fields: [supplierId], references: [id])
  items       PurchaseRequestItem[]
  purchase    Purchase?

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id           String   @id @default(uuid())
  requestId    String
  ingredientId String
  requestedQty Decimal  @db.Decimal(10, 3)
  approvedQty  Decimal? @db.Decimal(10, 3)

  request    PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ingredient Ingredient      @relation(fields: [ingredientId], references: [id])

  @@unique([requestId, ingredientId])
  @@map("purchase_request_items")
}

model PaymentLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  String   // "YYYY-MM-DD"
  endDate    String   // "YYYY-MM-DD"
  basePay    Decimal  @db.Decimal(10, 2)
  penalties  Decimal  @db.Decimal(10, 2)
  rewards    Decimal  @db.Decimal(10, 2)
  finalPay   Decimal  @db.Decimal(10, 2)
  rateType     String?  @db.VarChar(20) // snapshot of Employee.rateType at time of payment
  rate         Decimal? @db.Decimal(10, 2) // snapshot of Employee.rate at time of payment
  unitsWorked  Decimal? @db.Decimal(10, 2) // hours (Hourly) or shift/day count (Daily|PerShift); null for Monthly
  absentDays   Int?     // absence count used to compute `penalties` for this period
  notes        String?  // Optional pay details or reward description
  advanceAmount Decimal @default(0) @db.Decimal(10, 2)
  isAdvance     Boolean  @default(false)
  paidAt        DateTime @default(now())
  paidById      String
  paidBy        User     @relation("PaymentLogPaidBy", fields: [paidById], references: [id])
  completedDeliveries      Int      @default(0)
  totalDeliveryCommissions Decimal  @default(0) @db.Decimal(10, 2)

  @@index([employeeId])
  @@index([startDate, endDate])
  @@unique([employeeId, startDate, endDate, isAdvance])
  @@map("payment_logs")
}

model PurchasePayment {
  id           String   @id @default(uuid())
  purchaseId   String
  supplierId   String?
  amount       Decimal  @db.Decimal(10, 2)
  balanceAfter Decimal  @db.Decimal(10, 2)
  note         String?
  recordedById String?
  createdAt    DateTime @default(now())

  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation(fields: [recordedById], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  @@index([purchaseId])
  @@map("purchase_payments")
}

model OutletIngredientSupplier {
  id           String   @id @default(uuid())
  outletId     String
  ingredientId String
  supplierId   String

  outlet     Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([outletId, ingredientId])
  @@map("outlet_ingredient_suppliers")
}

